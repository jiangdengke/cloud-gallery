# Frontend (Vite) env example
#
# API base URL for browser requests.
# - Leave empty to use same-origin `/api` (dev uses Vite proxy; production uses Laravel public/)
# - For separated deployment, set to backend origin (auto appends `/api`) or full `/api` base:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#   VITE_API_BASE_URL=https://api.example.com
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

